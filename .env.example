# Copy this file to .env and fill it in. Never commit .env.

# Signs the session cookie. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The app's own MySQL account. Create it once as root (see the end of schema.sql)
MYSQL_USER=ta_app
MYSQL_PASSWORD=

# Leave these blank on your own computer (they default to localhost and ta_scheduler).
# On PythonAnywhere, use the single quotes so the $ is kept as-is:
#   MYSQL_HOST=yourname.mysql.pythonanywhere-services.com
#   MYSQL_DB='yourname$ta_scheduler'
MYSQL_HOST=
MYSQL_DB=

# Set this by running: python set_admin_password.py
ADMIN_PASSWORD_HASH=

# 1 turns on auto-reload and the debugger. Only use it on your own computer
FLASK_DEBUG=0
